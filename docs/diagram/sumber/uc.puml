@startuml
!include _skin.iuml
left to right direction
actor "Manajer Kota /\nOperator Pusat Kendali" as MK
actor "Petugas Lalu Lintas\n(Dishub / Polda)" as PL
actor "Analis Lingkungan\n(DLH)" as AL
actor "Petugas Pemeliharaan" as PP
actor "Warga /\nPengguna Publik" as WG
actor "Administrator Sistem" as AD
actor "Perangkat IoT" as IOT <<sistem>>
actor "Penjadwal Model\n(Cloud Scheduler)" as SCH <<sistem>>
rectangle "Smart City Monitoring System (SCMS)" {
  package "Lalu Lintas" {
    usecase "UC-01 Lihat Peta Lalu Lintas\nReal-Time" as UC01
    usecase "UC-02 Verifikasi &\nTangani Insiden" as UC02
    usecase "UC-03 Lihat Prakiraan\nKemacetan 1 Jam" as UC03
  }
  package "Lingkungan" {
    usecase "UC-04 Pantau Heatmap\nPolusi & Kebisingan" as UC04
    usecase "UC-05 Tanggapi Peringatan\nKualitas Udara" as UC05
    usecase "UC-06 Analisis Korelasi\nLalu Lintas–Udara" as UC06
  }
  package "Fasilitas Publik" {
    usecase "UC-07 Dispatch Pemeliharaan\nOtomatis" as UC07
    usecase "UC-08 Kelola Tiket\nPemeliharaan" as UC08
    usecase "UC-09 Lihat Dashboard\nAset per Zona" as UC09
  }
  package "Layanan Publik & Platform" {
    usecase "UC-10 Rencanakan Rute\n(Aplikasi Mobile)" as UC10
    usecase "UC-11 Lihat Info ISPU Publik" as UC11
    usecase "UC-12 Kirim Telemetri" as UC12
    usecase "UC-13 Daftarkan &\nKelola Perangkat" as UC13
    usecase "UC-14 Kelola Pengguna\n& Peran (RBAC)" as UC14
    usecase "UC-15 Jalankan Prediksi\nTerjadwal" as UC15
    usecase "Autentikasi (SSO + MFA)" as AUTH
  }
}
MK --> UC01
MK --> UC04
MK --> UC09
PL --> UC01
PL --> UC02
PL --> UC03
AL --> UC04
AL --> UC05
AL --> UC06
PP --> UC08
PP --> UC09
WG --> UC10
WG --> UC11
AD --> UC13
AD --> UC14
IOT --> UC12
SCH --> UC15
UC12 ..> UC07 : <<trigger>>
UC07 ..> UC08 : <<include>>
UC02 ..> AUTH : <<include>>
UC05 ..> AUTH : <<include>>
UC08 ..> AUTH : <<include>>
UC14 ..> AUTH : <<include>>
UC03 ..> UC01 : <<extend>>
@enduml
